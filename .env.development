# ============================================================================
# 玄镜后端 · 本地开发环境（APP_ENV=development 时自动加载）
#
# 本文件已提交到仓库，只放「与环境绑定、非敏感」的通用默认值。
# 密钥与本机路径（DATABASE_URL / JWT_SECRET / ENCRYPTION_KEY / REDIS_URL 等）
# 请写在 .env（gitignore）里，它的优先级低于本文件，不会被覆盖冲突。
#
# 优先级（高 → 低）：真实环境变量 > .env.development > .env
# ============================================================================

# ---- 应用 ----
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=玄镜 OracleMind 后端

# ---- 服务端口 ----
HOST=0.0.0.0
PORT=8000

# ---- CORS：本地前端 dev 端口（3000 默认 / 3001 冲突自切 / 3311 生产预览）----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:3311

# ---- 反向代理信任：本地无反代，关闭（否则客户端可伪造 X-Forwarded-*）----
PROXY_TRUSTED=false

# ---- JWT ----
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- 随喜订单有效期（分钟）----
DONATION_EXPIRE_MINUTES=30

# ---- 敏感接口限流（登录 / 注册防暴力破解）----
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=60
