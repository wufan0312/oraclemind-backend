# ============================================================
# 玄镜 OracleMind 后端 —— 环境变量模板
# 复制为 .env 后按需修改。DATABASE_URL 决定数据层形态：
#   - 本地开发 / 单机 demo  -> SQLite（零配置）
#   - staging / prod        -> PostgreSQL（外部托管，如 Neon / Supabase / Railway）
# 详见 DEPLOYMENT.md
# ============================================================

# ===== 应用 =====
APP_ENV=development            # development | production
DEBUG=true
LOG_LEVEL=INFO

# ===== 数据层 =====
# [开发] SQLite —— 零配置，文件即数据库
# DATABASE_URL=sqlite+aiosqlite:///./oraclemind.db

# [生产/Vercel] PostgreSQL —— 必须外部托管！Vercel 临时文件系统不能用 SQLite
# 示例（Neon / Supabase / Railway 取到的连接串，注意用 asyncpg 驱动）：
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./oraclemind.db

# ===== Redis =====
# 本地：redis://localhost:6379/0
# 托管：redis://<host>:6379/0（如 Upstash，注意 Vercel 需用 TLS 端点 rediss://）
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== 字段级加密（P0-4，必填生产项）=====
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空则回退到 jwt_secret 派生（仅开发可用，生产务必设独立强随机密钥）
ENCRYPTION_KEY=

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3311

# ===== 支付回调鉴权（P0 修复：防伪造 success 免费解锁付费权益）=====
# 供自有/代理渠道或 stub 本地模拟真实回调使用的回调令牌。
# 配置后，/premium/notify 与 /donations/notify 必须携带匹配令牌（header X-Payment-Token）才处理订单；
# 未配置时：生产环境（APP_ENV=production）自动拒绝回调（403，防伪造），开发环境放行（本地便利）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 真实微信支付接入时，应另行补 Wechatpay-Signature 验签，本令牌仅作通用一层防护。
PAYMENT_CALLBACK_SECRET=
