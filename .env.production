# ============================================================================
# 玄镜后端 · 生产环境（APP_ENV=production 时自动加载，Vercel 上生效）
#
# 本文件已提交到仓库，是生产的「兜底默认值」；
# Vercel 项目面板里配的同名变量优先级更高，会覆盖这里的取值。
#
# ⚠️ 这里刻意**不写任何密钥**。以下四项必须在 Vercel 面板配置，否则服务起不来：
#    DATABASE_URL     —— 必须是 postgresql+asyncpg://（本项目生产禁用 SQLite）
#    JWT_SECRET       —— 非默认占位符的强随机串
#    ENCRYPTION_KEY   —— Fernet 密钥：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#    REDIS_URL        —— 可选，不配则降级为进程内存缓存
# ============================================================================

# ---- 应用 ----
APP_ENV=production
# 生产必须关：engine.echo 会把含绑定参数的 SQL 打到 stdout，造成参数泄露
DEBUG=false
LOG_LEVEL=INFO

# ---- 服务端口（Vercel 会自行注入 PORT，这里仅作非 Vercel 部署的兜底）----
HOST=0.0.0.0
PORT=8000

# ---- CORS：线上前端域名（多个用逗号分隔，不要带尾部斜杠）----
CORS_ORIGINS=https://oraclemind-frontend.vercel.app

# ---- 反向代理信任：Vercel 边缘节点做 TLS 终结，需开启才能拿到正确 scheme ----
PROXY_TRUSTED=true

# ---- JWT ----
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- 随喜订单有效期（分钟）----
DONATION_EXPIRE_MINUTES=30

# ---- 敏感接口限流（生产收紧：5 次 / 60 秒）----
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=60

# ---- 支付回调鉴权 ----
# 生产未配置 PAYMENT_CALLBACK_SECRET 时，/premium/notify 与 /donations/notify
# 一律 403 拒绝（防伪造 success 免费解锁付费权益）。值请在 Vercel 面板配置。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
